# Projects — each has its own git repo
projects/

# Credentials — all secrets (entire folder)
credentials/

# Scratch — one-off experiments, not tracked
scratch/

# Claude Code local settings (may contain tokens/paths)
.claude/settings.local.json

# Claude Code runtime lock files (e.g. scheduled tasks)
.claude/*.lock

# Claude Code Plan Mode plan files — generated per session, folder structure only via .gitkeep
docs/plans/*
!docs/plans/.gitkeep

# Python bytecode cache (generated by tools/*.py)
**/__pycache__/

# Tool run logs
tools/.logs/

# Obsidian workspace metadata
.obsidian/
